{
  "name": "required-branch-names",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "Allowed branch names",
        "negate": false,
        "operator": "regex",
        "pattern": "^(local|develop|staging|main|master|(feature|fix|bugfix|hotfix|refactor|chore|docs|test)/[a-z0-9][a-z0-9._-]*)$"
      }
    }
  ]
}
